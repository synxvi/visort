<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- MediaStore 读取（Android 13+ / API 33+） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- 兼容 Android 12 及以下（API ≤ 32）走旧权限 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 媒体管理特殊权限（Android 12+）：授权后 createWriteRequest/createDeleteRequest 不弹窗 -->
    <uses-permission android:name="android.permission.MANAGE_MEDIA" />
    <!-- 配合 MANAGE_MEDIA，使 createWriteRequest 免弹窗 -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- 预测返回（predictive back）策略：
         该 flag 必须为 true：Android 16 的 WindowOnBackInvokedDispatcher$Checker 会拒绝
         flag=false 的应用注册 OnBackInvokedCallback（日志 “OnBackInvokedCallback is not
         enabled for the application”）。
         返回手势由 MainActivity 注册的 window 级 OnBackAnimationCallback（PRIORITY_OVERLAY）
         完全接管：动画回调全部 no-op → ①系统不播默认动画（相册网格重页面不再缩放抖动）；
         ②沉浸模式（隐藏系统栏）下右滑不再被系统消费用于“显示系统栏/再次滑动返回”，
         一次滑动直接返回（对齐 ColorOS 系统相册行为）；③onBackInvoked 转发 popRoute，
         PopScope/导航逻辑不受影响。 -->
    <application
        android:label="sortr_flutter"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Impeller 渲染后端：临时禁用切回 Skia,排查自定义字体(SpaceMono)在 Impeller
             下加载失败 fallback 成 sans 的问题(实测字母不等宽)。验证后决定恢复或修 ttf。 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
