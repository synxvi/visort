<?xml version="1.0" encoding="utf-8"?>
<!-- 启动屏背景。
     应用为纯深色（AppColors.bg = #0D0D0D），启动屏底色与之对齐，
     消除冷启动瞬间「系统亮色窗口 → Flutter 深色 UI」的白闪跳变。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/visort_launch_bg" />

    <!-- 如需启动 logo，可在此插入 bitmap：
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item> -->
</layer-list>
